# 应用配置
APP_NAME=funfact-server
APP_PORT=3000
APP_ENV=development

# 数据库配置 - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=funfact
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/funfact

# Elasticsearch 配置
ELASTICSEARCH_NODE=http://localhost:9200

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_LOCAL_PATH=./uploads

# 微信小程序配置
# 注意：变量名必须是 WECHAT_APPID 和 WECHAT_SECRET（无下划线）
WECHAT_APPID=your-wechat-app-id
WECHAT_SECRET=your-wechat-app-secret

# QQ 登录配置
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# 抖音配置
DOUYIN_APP_ID=your-douyin-app-id
DOUYIN_APP_SECRET=your-douyin-app-secret

# Apple 登录配置
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# 阿里云 OSS 配置（图片存储）
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# AI 服务配置
AI_API_KEY=your-ai-api-key
AI_API_ENDPOINT=your-ai-api-endpoint
AI_DAILY_USAGE_LIMIT=100
